# RIN GARDEN SYSTEM - 環境変数テンプレート
# このファイルをコピーして .env を作成し、実際の値を設定してください。
# .env はGitにコミットしないでください(.gitignoreで除外済み)。

# Google Sheets認証(優先順位: 1) User OAuth 2) ADC 3) Service Account 4) dry-run)
#
# 1) User OAuth(推奨・第一候補): Google Cloud Consoleで「OAuth 2.0 クライアントID」
#    (アプリケーションの種類: デスクトップアプリ)を作成し、ダウンロードしたJSONを
#    プロジェクト直下に `credentials.json` として配置してください
#    (パスは下記の環境変数で変更可能)。初回のみ `sheets-check` 等の実行時にブラウザが
#    開きGoogleログイン・承認を求められます。承認後は `token.json` に認証結果が
#    保存され、以後は再ログイン不要です。credentials.json / token.json は
#    どちらもGitにコミットされません(.gitignoreで除外済み)。
GOOGLE_OAUTH_CLIENT_SECRET_FILE=credentials.json
GOOGLE_OAUTH_TOKEN_FILE=token.json

# 2) ADC (Application Default Credentials): `gcloud auth application-default login`
#    を実行済みの環境、またはGOOGLE_APPLICATION_CREDENTIALSがADCとして解釈可能な
#    JSON(サービスアカウント/authorized_user)を指している場合に使われます。

# 3) Service Account(組織ポリシーでサービスアカウントキーの発行が禁止されている
#    場合など、User OAuth/ADCが使えない環境向けのFallback。IAM鍵発行が可能な
#    環境でのみ使用してください):
GOOGLE_APPLICATION_CREDENTIALS=

# 競技別 Google Sheet ID(スプレッドシートURLの /d/ と /edit の間の文字列)
GOOGLE_SHEET_ID_JRA=
GOOGLE_SHEET_ID_NAR=
GOOGLE_SHEET_ID_BOAT=
GOOGLE_SHEET_ID_KEIRIN=
