# RIN GARDEN SYSTEM - 環境変数テンプレート
# このファイルをコピーして .env を作成し、実際の値を設定してください。
# .env はGitにコミットしないでください(.gitignoreで除外済み)。

# Googleサービスアカウントの認証情報JSONへの絶対パス
GOOGLE_APPLICATION_CREDENTIALS=

# 競技別 Google Sheet ID(スプレッドシートURLの /d/ と /edit の間の文字列)
GOOGLE_SHEET_ID_JRA=
GOOGLE_SHEET_ID_NAR=
GOOGLE_SHEET_ID_BOAT=
GOOGLE_SHEET_ID_KEIRIN=
